import java.util.Scanner;
public class leastCoinsChallenge {
  public static void main(String[] args) {
    Scanner scanner = new Scanner(System.in);
    System.out.print("How many cents? Enter: ");
    int numCents = scanner.nextInt();
    
    if (numCents <= 0) {
      System.out.println("Please enter a positive value.");
      scanner.close();
      return;
    }
    
    String centPluralCheck = (numCents == 1)? " cent:" : " cents:";
    System.out.println("Here are the coins I would give you for " + numCents + centPluralCheck);
    
    int[] coinValue = {25, 10, 5, 1};
    int[] coinCounts = new int[4];
    
    for (int i = 0; i < 4; i++) {
            coinCounts[i] = numCents / coinValue[i];
            numCents %= coinValue[i];
        }
    
    String[] coinSingle = {"quarter,", "dime,", "nickel, and", "penny."};
    String[] coinPlural = {"quarters,", "dimes,", "nickels, and", "pennies."};
    
    StringBuilder coinsGiven = new StringBuilder();
    
    for (int i = 0; i < 4; i++) {
        int coinCount = coinCounts[i];
        String pluralCheck = (coinCount == 1) ? coinSingle[i] : coinPlural[i];
        coinsGiven.append(coinCount).append(" ").append(pluralCheck).append(" ");
    }
    
    System.out.println(coinsGiven);
    
    int coinSum = 0;
    
    for (int i = 0; i < 4; i++) {
        coinSum += coinCounts[i];
    }
    
    System.out.println("That's " + coinSum + " coins in total.");
    
    scanner.close();
  } 
}
